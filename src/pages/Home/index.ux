<template>
  <div class="app" onswipe="onSwipeBack">
    <!-- ================= title ================= -->
    <div class="screen title" if="{{ phase === 'title' }}">
      <image class="logo" src="/assets/images/logo.png"></image>
      <text class="h1">妈妈把我的游戏机藏起来了</text>
      <text class="sub">房间解谜 · 原创致敬</text>
      <div class="hero">
        <image class="heromom" src="/assets/images/mom.png"></image>
        <text class="heroq">?</text>
        <image class="herocon" src="/assets/images/console.png"></image>
      </div>
      <text class="rule">左右箭头换房间，点物件找线索。</text>
      <text class="rule">找道具、用道具，别让妈妈起疑心。</text>
      <div class="btn" onclick="onStart">
        <text class="btnt">开始游戏</text>
      </div>
      <div class="btn ghost" onclick="onRandom">
        <text class="btnt ghostt">随机模式</text>
      </div>
      <div class="btn danger" onclick="openHell">
        <text class="btnt">地狱模式</text>
      </div>
      <div class="btn ghost smallbtn" onclick="openSettings">
        <text class="btnt ghostt smallt">设置</text>
      </div>
      <text class="foot">原创美术 · 不含商业游戏素材</text>

      <div class="overlay" if="{{ hellWarn }}">
        <div class="panel">
          <image class="warnico" src="/assets/images/warning.png"></image>
          <text class="warnh">地狱模式</text>
          <text class="warnt">地狱模式：2 格疑心，每错 2 次涨 1 格（最多错 4 次）；120 秒内通关，解锁全部关卡。</text>
          <div class="warnbtns">
            <div class="btn half ghost" onclick="closeHell"><text class="btnt ghostt">取消</text></div>
            <div class="btn half danger" onclick="startHell"><text class="btnt">开始</text></div>
          </div>
        </div>
      </div>

      <div class="overlay" if="{{ settingsOpen }}">
        <div class="panel">
          <text class="warnh">设置</text>
          <div class="setrow" onclick="toggleVibrate">
            <text class="setl">点击震动</text>
            <text class="setv">{{ vibrateOn ? '开' : '关' }}</text>
          </div>
          <text class="devline">开发人员：绘0-0</text>
          <div class="btn" onclick="closeSettings"><text class="btnt">完成</text></div>
        </div>
      </div>
    </div>


    <!-- ================= select ================= -->
    <div class="screen select" if="{{ phase === 'select' }}">
      <text class="selh">选关</text>
      <text class="selhint">通关后解锁下一天</text>
      <div class="dayrow {{ d.locked ? 'daylock' : '' }}" for="{{ (i, d) in dayItems }}" onclick="onPickDay(i)">
        <div class="dayno"><text class="daynot">{{ d.no }}</text></div>
        <div class="daymid">
          <text class="dayname">{{ d.name }}</text>
          <text class="dayroom">{{ d.locked ? '通关后解锁' : '进入这一天' }}</text>
        </div>
        <image class="daylockico" if="{{ d.locked }}" src="/assets/images/lock.png"></image>
        <text class="dayarrow" if="{{ !d.locked }}">›</text>
      </div>
      <text class="backlink" onclick="backTitle">返回标题</text>
    </div>

  </div>
</template>

<style>
